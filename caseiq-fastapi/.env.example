# Copy to .env and fill in. NEVER commit the real .env.
ENV=development
DEBUG=true

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars

ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=caseiq

# Managed-Postgres (Neon) override -- set BOTH to deploy against Neon instead
# of the POSTGRES_* fields above (which stay in effect for local dev when
# these are unset). Get both from Neon's dashboard connection-details panel,
# toggling its "pooled connection" checkbox. Never commit real values here.
#   DATABASE_URL_RAW    -- Neon's POOLED endpoint (hostname has "-pooler" in
#                          it). The app's runtime engine uses this.
#   DATABASE_URL_DIRECT -- Neon's DIRECT endpoint (no "-pooler"). Alembic
#                          migrations use this -- Neon's pooled endpoint
#                          runs pgbouncer in transaction mode, which breaks
#                          the DDL/locking behaviour migrations depend on.
# DATABASE_URL itself is NOT a setting -- it's always computed from the
# above (see app/core/config.py), setting it here would do nothing.
# DATABASE_URL_RAW=
# DATABASE_URL_DIRECT=

REDIS_URL=redis://localhost:6379/0

# LLM / embeddings / news (optional in dev — app degrades gracefully)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
EMBEDDING_PROVIDER=local      # local | gemini
EMBEDDING_DIM=768
NEWS_API_KEY=

# Audit log retention in days (app.tasks.worker.cleanup_audit_logs runs daily)
AUDIT_LOG_RETENTION_DAYS=90

# Copy to .env and fill in. NEVER commit the real .env.
ENV=development
DEBUG=true

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars

ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=caseiq

REDIS_URL=redis://localhost:6379/0

# LLM / embeddings / news (optional in dev — app degrades gracefully)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
EMBEDDING_PROVIDER=local      # local | gemini
EMBEDDING_DIM=768
NEWS_API_KEY=

# Audit log retention in days (app.tasks.worker.cleanup_audit_logs runs daily)
AUDIT_LOG_RETENTION_DAYS=90
